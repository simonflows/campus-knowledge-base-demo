# ============================================================
# Канон кампуса «Южный Урал» — Переменные окружения
# ============================================================
# Скопируйте этот файл в .env.local (или запустите `npm run setup` / `setup-keys.bat`)

# 1. БОЕВОЙ РОССИЙСКИЙ КОНТУР (152-ФЗ РФ): Yandex AI Studio
YANDEX_AI_STUDIO_API_KEY=
YANDEX_AI_STUDIO_FOLDER_ID=
# Необязательно (по умолчанию gpt://<folder_id>/yandexgpt/latest):
# YANDEX_AI_STUDIO_MODEL_URI=

# 2. РЕЗЕРВНОЕ ХРАНИЛИЩЕ: Яндекс Диск OAuth (автовыгрузка .md и .csv)
YANDEX_DISK_OAUTH_TOKEN=

# 3. УЧЕБНЫЙ И ИССЛЕДОВАТЕЛЬСКИЙ ПОЛИГОН: Alibaba Cloud Model Studio (Qwen)
# Внимание: при работе с этим контуром ПДн автоматически обезличиваются (152-ФЗ)
ALIBABA_DASHSCOPE_API_KEY=
ALIBABA_MODEL_NAME=qwen-plus
ALIBABA_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 4. РЕЖИМ РАБОТЫ И БЕЗОПАСНОСТЬ (необязательно для локального запуска)
# Секретный ключ подписи кук HMAC-SHA256 (рекомендуется задать случайную строку 32+ символов):
# SESSION_SECRET=
# ПИН-код входа для роли «Администратор канона» (если не задан — работает вход в 1 клик):
# ADMIN_ACCESS_PIN=
# FORCE_SECURE_COOKIE=true
# Установите false, чтобы не загружать 3 тестовые статьи при первом старте:
# SEED_DEMO_ARTICLES=false
# Установите true, чтобы показать на сайте демо-вкладку «Архитектура и ИИ», кнопку «ИИ и ключи» и выбор ИИ-движка:
# NEXT_PUBLIC_DEMO_MODE=true

# 5. БАЗА ДАННЫХ (опционально для локального запуска)
# Если DynamoDB/YDB не настроена, сервис автоматически сохраняет данные в .data/local-store.json
# DOCUMENT_API_ENDPOINT=http://localhost:8000
# DOCUMENT_API_REGION=ru-central1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# USE_DATABASE=true
